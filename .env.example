# Google Drive OAuth2 (credentials.json von Google Cloud Console herunterladen)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# Embedding provider: "gemini" oder "ollama"
EMBEDDING_PROVIDER=gemini

# Ollama (nur wenn EMBEDDING_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Sync interval in Minuten
SYNC_INTERVAL_MINUTES=5

# Pfad zur SQLite Datenbank
DB_PATH=data/documents.db

# Pfad für temporäre Downloads
DOWNLOAD_PATH=data/downloads
